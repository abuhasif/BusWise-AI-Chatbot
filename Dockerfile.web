# Buswise web app (React + vinext) as a plain Node server.
#   docker build -f Dockerfile.web -t buswise-web .
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# Node target: skips the Cloudflare Workers plugins used by the default build.
RUN BUSWISE_TARGET=node npx vinext build

FROM node:22-slim
ENV NODE_ENV=production PORT=3000
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=build /app/dist ./dist
# Source maps would reveal the original source; they aren't needed at runtime.
RUN find dist -name '*.map' -delete
USER node
EXPOSE 3000
CMD ["npx", "vinext", "start"]
