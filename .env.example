# Copy to .env (git-ignored) and fill in. Never commit real values.

# Required for Docker Compose: shared secret between the gateway and the Python API.
# Generate one with: openssl rand -hex 32
BUSWISE_API_TOKEN=

# Optional. Enables live OneMap bus-only journey planning.
# Recommended: your OneMap account (register free at https://www.onemap.gov.sg/apidocs/register).
# The API signs in and renews the 3-day token automatically.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
# Alternative: a token you fetched yourself (expires after 3 days).
ONEMAP_TOKEN=

# Optional gateway settings
# TRUST_PROXY=1                      # only when a proxy/load balancer sits in front
# ALLOWED_ORIGINS=https://example.com # extra origins allowed to call /api from a browser
# RATE_LIMIT_PER_MINUTE=60
# CHAT_RATE_LIMIT_PER_MINUTE=20
# GLOBAL_RATE_LIMIT_PER_MINUTE=300
